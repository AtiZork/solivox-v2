# --- Client Sydney server (local validator) — ACTIVE FOR DEPLOY ---
USE_LOCAL_NODE=true
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_WS_URL=ws://127.0.0.1:8900
SECURE_DIRECTORY=/home/rwts/Documents

# Optional: leave empty so sniper/price WS stay on local node only
SOLANA_WS_URL_FALLBACK=

SNIPER_USE_WEBSOCKET=true
SNIPER_HTTP_FALLBACK=true
# Default (0.25s = 4 req/s) is tuned for rate-limited public RPC. On a
# dedicated local validator this can usually go much lower, e.g. 0.02 (50/s) —
# watch validator load/latency before dropping it further.
# SNIPER_RPC_MIN_INTERVAL_SEC=0.25

PRICE_USE_WEBSOCKET=true
PRICE_HTTP_FALLBACK=true

# Shyft (token get_info REST + RPC/WS). Do not commit real keys.
# SHYFT_API_KEY=
# SHYFT_RPC_URL=https://rpc.shyft.to?api_key=YOUR_KEY
# SHYFT_WS_URL=wss://rpc.shyft.to?api_key=YOUR_KEY
# SHYFT_API_BASE=https://api.shyft.to
# SHYFT_NETWORK=mainnet-beta

# Yellowstone/Geyser gRPC (sniper sell-flow price fetch). USE_GEYSER=false
# keeps the sniper sell scheduler on the existing Shyft pricing path.
USE_GEYSER=false
# GEYSER_GRPC_URL=your-endpoint.example.com:443
# GEYSER_GRPC_TOKEN=
# GEYSER_USE_TLS=true
# GEYSER_PRICE_TIMEOUT_SEC=8
# Sniper sell cycle: how many open trades are priced at once (sells stay sequential).
# SNIPER_SELL_PRICE_WORKERS=10
# Backup sell-decision cycle interval. The instant per-mint trigger (below) is
# the real speed path; this is only the safety net. Lower = more Shyft RPC
# calls per open trade per tick — watch for 429s with many open positions.
# SNIPER_SELL_CYCLE_INTERVAL_SEC=1
# Instant sells: re-check an open trade the moment its token trades (node WebSocket).
# SNIPER_SELL_STREAM=true
# SNIPER_SELL_STREAM_SYNC_SEC=5
# SNIPER_SELL_EVENT_WORKERS=8
# How long a fetched SOL/USD price is reused before refetching (every sell
# price read calls this; caching it removes a full extra Shyft RPC round trip).
# SOL_USD_PRICE_CACHE_TTL_SEC=1.5
# Confirms "sent" sells against their real on-chain outcome and restores the
# position if one failed after send_transaction accepted it for broadcast.
# SNIPER_SELL_RECONCILE_INTERVAL_SEC=10
# SNIPER_SELL_RECONCILE_TIMEOUT_SEC=90

# --- Dev machine (public mainnet) — uncomment only for local Windows testing ---
